# ==============================================================================
# Collab+ Monorepo — Phase 2 Environment Variables Template
# Copy to `.env` for local development. Never commit `.env` or real secrets.
# ==============================================================================

# --- Backend API (@repo/api) ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Frontend Web App (@repo/web) ---
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

# --- Persistence & Cache (Phase 2) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collab_plus
REDIS_URL=redis://localhost:6379

# --- Auth & End-to-End Encryption (E2EE) ---
AUTH_JWT_SECRET=replace-with-local-dev-secret-min-32-chars
E2EE_KEY_AUTHORITY_PUBLIC_KEY=replace-with-dev-public-key

# --- External Activity & Integration Plugins (Optional in Local Dev) ---
WAKATIME_CLIENT_ID=
WAKATIME_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
LEETCODE_SYNC_ENABLED=false

# --- CollabBot AI Integration ---
AI_PROVIDER_API_KEY=
AI_MODEL_ID=
