{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@repo/shared": ["./packages/shared/src/index.js"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["apps/**/*", "packages/**/*"],
  "exclude": ["node_modules", "**/node_modules", "dist", "**/dist"]
}
