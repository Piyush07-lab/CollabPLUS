{
  "name": "@repo/api",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node --input-type=module -e \"import { spawn } from 'node:child_process'; const procs = [spawn('tsc', ['-p', 'tsconfig.build.json', '--watch', '--preserveWatchOutput'], { stdio: 'inherit', shell: true }), spawn(process.execPath, ['--watch', 'dist/main.js'], { stdio: 'inherit' })]; const stop = () => procs.forEach((p) => p.kill()); process.on('SIGINT', stop); process.on('SIGTERM', stop);\"",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "db:generate": "tsc -p tsconfig.build.json && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "tsc -p tsconfig.build.json && drizzle-kit push",
    "db:studio": "tsc -p tsconfig.build.json && drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-fastify": "^12.5.1",
    "@node-rs/argon2": "^2.2.2",
    "@repo/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
